# === LinkedIn ===
# Manual login: set --headless false, browser opens, you log in manually.
# Session is kept across all jobs in a single `--portal linkedin` run.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# === Computrabajo ===
# Manual login: set --headless false, browser opens, you log in manually.
COMPUTRABAJO_EMAIL=
COMPUTRABAJO_PASSWORD=

# === GetOnBoard ===
# Google OAuth only — cannot automate. Submit these jobs manually.
GETONBRD_EMAIL=
GETONBRD_PASSWORD=

# === The Muse, WeWorkRemotely, freehire, Jobicy, Remotive ===
# These are redirect-based (no login). Credentials not needed.
THEMUSE_EMAIL=
THEMUSE_PASSWORD=
WEWORKREMOTELY_EMAIL=
WEWORKREMOTELY_PASSWORD=
FREEHIRE_EMAIL=
FREEHIRE_PASSWORD=
JOBICY_EMAIL=
JOBICY_PASSWORD=
REMOTIVE_EMAIL=
REMOTIVE_PASSWORD=

# === Global ===
HEADLESS=false      # false = visible browser (for manual login portals)
SLOW_MO=300         # ms between actions (slower = more reliable)
TIMEOUT=45000       # page timeout in ms
