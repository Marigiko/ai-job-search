{
  "name": "job-submission-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "100% automated job application submission for multiple portals",
  "scripts": {
    "submit": "node cli.js",
    "submit:strong": "node cli.js --min-score 75",
    "submit:good": "node cli.js --min-score 60",
    "submit:portal": "node cli.js --portal",
    "submit:dry": "node cli.js --dry-run"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "playwright": "^1.61.1"
  }
}
