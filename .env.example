# .env.example — copy to .env and fill in

# Gmail (obligatorio para envío de emails)
# Generá tu App Password en: https://myaccount.google.com/apppasswords
GMAIL_SENDER=you@example.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Serper.dev — LinkedIn search (2500 calls gratis). Registro: https://serper.dev
SERPER_API_KEY=

# Hunter.io — Email finder (25 búsquedas/mes gratis). Registro: https://hunter.io
HUNTER_API_KEY=

# Apollo.io — Email finder (60 créditos/mes gratis). Registro: https://apollo.io
APOLLO_API_KEY=

# Product Hunt — Startup discovery. Token: https://www.producthunt.com/v2/oauth/applications
PRODUCT_HUNT_TOKEN=
